# Copy this file to .env (gitignored). Values here are examples only —
# put machine-specific paths, model names and API keys in .env, never in git.
# Environment variables set in the shell override this file.

HOLOBOX_ENVIRONMENT=development
HOLOBOX_HOST=127.0.0.1
HOLOBOX_PORT=8000
HOLOBOX_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional LAN protection. Never commit the real token.
# HOLOBOX_API_TOKEN=change-me

# --- LLM provider -------------------------------------------------------
# mock | http | college | none
# Local Ollama exposes an OpenAI-compatible API at /v1.
HOLOBOX_LLM_PROVIDER=http
HOLOBOX_LLM_BASE_URL=http://127.0.0.1:11434/v1
HOLOBOX_LLM_MODEL=llama3.2:latest
HOLOBOX_LLM_TIMEOUT_SECONDS=120
# HOLOBOX_LLM_API_KEY=                # Ollama needs none; college provider will.
# For development only: HOLOBOX_LLM_PROVIDER=mock (never in production).

HOLOBOX_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HOLOBOX_CHROMA_COLLECTION=holobox_chunks
HOLOBOX_CHUNK_SIZE=800
HOLOBOX_CHUNK_OVERLAP=120
HOLOBOX_RETRIEVAL_TOP_K=5
HOLOBOX_RETRIEVAL_MIN_SCORE=0.15

HOLOBOX_STT_MODEL=base
HOLOBOX_STT_DEVICE=cpu
# HOLOBOX_STT_LANGUAGE=en

# Local Piper (use the real paths for this machine in .env)
HOLOBOX_PIPER_BINARY=/path/to/piper/bin/piper
HOLOBOX_PIPER_VOICE=/path/to/voice.onnx
