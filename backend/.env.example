# Copy this file to .env (gitignored). Values here are examples only —
# put machine-specific paths, credentials and model names in .env, never in git.
# Shell environment variables override this file.

HOLOBOX_ENVIRONMENT=development
HOLOBOX_HOST=127.0.0.1
HOLOBOX_PORT=8000
# Include the MacBook's LAN IP/hostname when running the kiosk on another PC.
HOLOBOX_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Optional shared secret for the legacy API-token header. Not a login credential.
# HOLOBOX_API_TOKEN=change-me

# --- Role-based access ---------------------------------------------------
HOLOBOX_AUTH_ENABLED=true
HOLOBOX_TEACHER_USERNAME=teacher
HOLOBOX_TEACHER_DISPLAY_NAME=Teacher
# Generate with: cd backend && python -m scripts.hash_password "your-password"
HOLOBOX_TEACHER_PASSWORD_HASH=paste-pbkdf2-hash-here
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
HOLOBOX_AUTH_SECRET=paste-random-secret-here
HOLOBOX_KIOSK_TOKEN=paste-random-kiosk-token-here
# Empty = kiosk may use every active course; comma-separated ids to restrict.
# HOLOBOX_KIOSK_COURSES=gpu-architecture
HOLOBOX_SEED_COURSES=gpu-architecture:GPU Architecture & Programming;general:General Studies

# --- LLM provider -------------------------------------------------------
HOLOBOX_LLM_PROVIDER=http
HOLOBOX_LLM_BASE_URL=http://127.0.0.1:11434/v1
HOLOBOX_LLM_MODEL=llama3.2:latest
HOLOBOX_LLM_TIMEOUT_SECONDS=120
# HOLOBOX_LLM_API_KEY=                # college provider will need one.
# mock is development-only and rejected when HOLOBOX_ENVIRONMENT=production.

HOLOBOX_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HOLOBOX_CHROMA_COLLECTION=holobox_chunks
HOLOBOX_CHUNK_SIZE=800
HOLOBOX_CHUNK_OVERLAP=120
HOLOBOX_RETRIEVAL_TOP_K=5
HOLOBOX_RETRIEVAL_MIN_SCORE=0.15

HOLOBOX_STT_MODEL=base
HOLOBOX_STT_DEVICE=cpu
# HOLOBOX_STT_LANGUAGE=en

# Local Piper paths (real values belong in .env, not here)
HOLOBOX_PIPER_BINARY=/path/to/piper/bin/piper
HOLOBOX_PIPER_VOICE=/path/to/voice.onnx
