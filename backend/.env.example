# All settings use the HOLOBOX_ prefix. Copy to .env to override.
HOLOBOX_ENVIRONMENT=development
HOLOBOX_DATA_DIR=./data
HOLOBOX_HOST=127.0.0.1
HOLOBOX_PORT=8000
HOLOBOX_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional LAN protection. Never put this value in frontend code.
# HOLOBOX_API_TOKEN=change-me

# LLM provider: mock | http | college | none
# mock is refused when HOLOBOX_ENVIRONMENT=production.
HOLOBOX_LLM_PROVIDER=mock
# HOLOBOX_LLM_BASE_URL=
# HOLOBOX_LLM_API_KEY=
# HOLOBOX_LLM_MODEL=

HOLOBOX_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HOLOBOX_CHROMA_COLLECTION=holobox_chunks
HOLOBOX_CHUNK_SIZE=800
HOLOBOX_CHUNK_OVERLAP=120
HOLOBOX_RETRIEVAL_TOP_K=5

HOLOBOX_STT_MODEL=base
HOLOBOX_STT_DEVICE=cpu
# HOLOBOX_PIPER_BINARY=/path/to/piper
# HOLOBOX_PIPER_VOICE=/path/to/voice.onnx
