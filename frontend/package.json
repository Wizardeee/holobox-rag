{
  "name": "holobox-kiosk",
  "version": "0.1.5",
  "description": "Holobox student kiosk — local frontend for the Holobox RAG backend",
  "author": "Holobox Project",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:teacher": "vite --port 5174",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "electron:build": "tsc -p tsconfig.electron.json",
    "electron": "electron dist-electron/main.js",
    "dist": "npm run build && npm run electron:build && electron-builder",
    "dist:win": "npm run build && npm run electron:build && electron-builder --win --x64 -p never",
    "test": "node --test src/kiosk/transcript.test.ts src/avatar/vrmAvatar.test.ts src/avatar/vrmLoad.test.ts src/avatar/framing.test.ts src/detection/presenceTracker.test.ts",
    "generate:api-types": "node scripts/generate-api-types.mjs",
    "check:api-types": "node scripts/generate-api-types.mjs --check"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.35",
    "@types/three": "^0.171.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.171.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "openapi-typescript": "^7.4.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "build": {
    "appId": "com.holobox.kiosk",
    "productName": "Holobox Kiosk",
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "installer"
    },
    "icon": "build/icon.ico",
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Holobox-Kiosk-${version}-x64.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Holobox Kiosk",
      "deleteAppDataOnUninstall": false
    }
  }
}
