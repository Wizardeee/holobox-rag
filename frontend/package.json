{
  "name": "holobox-rag-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "electron:build": "tsc -p tsconfig.electron.json",
    "electron": "electron dist-electron/main.js",
    "dist": "npm run build && npm run electron:build && electron-builder",
    "generate:api-types": "node scripts/generate-api-types.mjs",
    "check:api-types": "node scripts/generate-api-types.mjs --check"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "openapi-typescript": "^7.4.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "build": {
    "appId": "com.holobox.rag",
    "productName": "Holobox RAG",
    "files": ["dist/**", "dist-electron/**"],
    "mac": { "target": "dmg" },
    "win": { "target": "nsis" }
  }
}
