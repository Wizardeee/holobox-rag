# Vite build/dev variables (teacher portal browser fetch via /api proxy)
VITE_BACKEND_URL=http://127.0.0.1:8000
# Optional override for the avatar GLB URL; default is /avatar/sabrina_3d_avatar.glb
# VITE_AVATAR_MODEL_URL=/avatar/sabrina_3d_avatar.glb

# Electron kiosk variables — set these in the shell that launches `npm run electron`
# (they are read by electron/main.ts, not bundled into the renderer).
# On the Windows Holobox PC, use the MacBook's LAN address.
# HOLOBOX_BACKEND_URL=http://192.0.2.10:8000
# HOLOBOX_KIOSK_TOKEN=paste-token-from-backend-env
# HOLOBOX_KIOSK_COURSE=gpu-architecture
# HOLOBOX_KIOSK_FULLSCREEN=false
